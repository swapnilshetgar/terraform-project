#!/bin/bash
set -euxo pipefail
dnf install -y nginx
mkdir -p /usr/share/nginx/html
cat > /usr/share/nginx/html/index.html <<'HTML'
<!doctype html><html><head><meta charset="utf-8"><title>Three-Tier Demo</title><style>body{font-family:system-ui;max-width:700px;margin:60px auto;padding:20px;background:#eef2ff;color:#172554}.card{background:white;padding:30px;border-radius:16px;box-shadow:0 8px 30px #0002}button{padding:10px 16px;border:0;border-radius:8px;background:#2563eb;color:white}</style></head><body><div class="card"><h1>Three-Tier AWS Demo</h1><p>Nginx is serving this page from the private web tier.</p><button onclick="loadApi()">Call Flask API</button><pre id="result">Ready.</pre></div><script>async function loadApi(){const r=await fetch('/api/message');document.getElementById('result').textContent=JSON.stringify(await r.json(),null,2)}</script></body></html>
HTML
cat > /etc/nginx/conf.d/sample.conf <<NGINX
server { listen 80 default_server; root /usr/share/nginx/html; location /health { return 200 'ok\n'; add_header Content-Type text/plain; } location /api/ { proxy_pass http://127.0.0.1:${app_port}; proxy_set_header Host \$host; proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for; } location / { try_files \$uri \$uri/ =404; } }
NGINX
rm -f /etc/nginx/conf.d/default.conf
systemctl enable --now nginx
